  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p database/tsconfig.json && tsc --noEmit -p local/api && tsc --noEmit -p local/invocation && tsc --noEmit -p local/websocket",
    "test": "node ../../scripts/with-test-project.mjs node test/run-suites.cjs",
    "test:framework": "node ../../scripts/with-test-project.mjs node --import tsx --test test/*.test.ts database/test/*.test.ts",
    "test:cdk": "node ../../scripts/with-test-project.mjs --framework-root node --import tsx --test --test-concurrency=4 test/cdk/*.test.ts",
    "test:local-api": "node ../../scripts/with-test-project.mjs --framework-root node --import tsx --test local/api/test/*.test.ts",
    "test:local-invocation": "node ../../scripts/with-test-project.mjs node --import tsx --test local/invocation/test/*.test.ts",
    "test:local-websocket": "node ../../scripts/with-test-project.mjs --framework-root node --import tsx --test local/websocket/test/*.test.ts"
  },
